# Environnement de developpement. Copier en "server/.env.dev".

PGDATABASE_COMMON=samsecure_common_staging
PGDATABASE_TENANT=samsecure_tenant_client01_staging
PORT=3001

# Generer avec : openssl rand -hex 32
# Une valeur DIFFERENTE par cle et par environnement. Des secrets partages
# entre dev et staging rendraient un jeton emis d'un cote valide de l'autre.
JWT_ACCESS_SECRET=A_RENSEIGNER
JWT_REFRESH_SECRET=A_RENSEIGNER

# Repertoire de stockage des fichiers de preuve (#49). Doit rester hors de
# /var/www/samsecure : le rsync --delete des workflows de deploiement effacerait
# les fichiers deposes, et un alias NGINX les exposerait en HTTP.
# Cree et detenu par l'utilisateur qui execute PM2 :
#   sudo mkdir -p /var/lib/samsecure/preuves
#   sudo chown deploy:deploy /var/lib/samsecure/preuves
#   sudo chmod 750 /var/lib/samsecure/preuves
PREUVES_DIR=/var/lib/samsecure/preuves

# Controle des permissions API. true (defaut) refuse en 403 toute action
# non couverte par les droits. false journalise le refus sans bloquer, pour
# observer avant de couper. Toute valeur autre que "false" vaut strict.
RBAC_STRICT=true

# Controle de l'origine des appels sensibles (definition de mot de passe).
# true : seuls les appels portant une origine de la liste sont acceptes.
# false ou absent : l'appel passe, l'origine est journalisee.
# Laisser false en developpement, les appels directs y sont l'outil de travail.
ORIGINE_STRICTE=true
ORIGINES_AUTORISEES=https://staging-samsecure.nayrod.fr

# URL publique du front, utilisee pour construire le lien de reinitialisation.
# Sans elle le lien est relatif et inexploitable dans un mail.
URL_PUBLIQUE=https://staging-samsecure.nayrod.fr