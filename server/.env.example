# Socle commun a tous les environnements.
# Copier en "server/.env" et renseigner les valeurs marquees A_RENSEIGNER.
# Le fichier .env resultant ne doit JAMAIS etre committe.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=samsecure_app

# Generer avec : openssl rand -hex 24
# Hexadecimal uniquement, volontairement : un mot de passe contenant $, ! ou `
# est corrompu par tout script qui ferait un "source" de ce fichier.
PGPASSWORD=A_RENSEIGNER

# Controle des permissions API. true (defaut) refuse en 403 toute action
# non couverte par les droits. false journalise le refus sans bloquer, pour
# observer avant de couper. Toute valeur autre que "false" vaut strict.
RBAC_STRICT=true
