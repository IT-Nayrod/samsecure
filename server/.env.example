# Socle commun a tous les environnements.
# Copier en "server/.env" et renseigner les valeurs marquees A_RENSEIGNER.
# Le fichier .env resultant ne doit JAMAIS etre committe.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=samsecure_app

# Generer avec : openssl rand -hex 24
# Hexadecimal uniquement, volontairement : un mot de passe contenant $, ! ou `
# est corrompu par tout script qui ferait un "source" de ce fichier.
PGPASSWORD=A_RENSEIGNER

# Controle des permissions API. true (defaut) refuse en 403 toute action
# non couverte par les droits. false journalise le refus sans bloquer, pour
# observer avant de couper. Toute valeur autre que "false" vaut strict.
RBAC_STRICT=true

# URL publique du front, utilisee pour construire le lien de reinitialisation.
# Sans elle le lien est relatif et inexploitable dans un mail.
URL_PUBLIQUE=https://staging-samsecure.nayrod.fr
# Envoi de mails (#87). Lu exclusivement par server/utils/mail.js, aucune
# valeur de repli dans le code : tant que ces variables sont absentes, tout
# envoi est refuse proprement (code 1001) et trace dans log_serveur.
# SMTP_SECURE : "true" pour TLS implicite (port 465), sinon "false" (STARTTLS).
# MAIL_REPLY_TO est optionnelle, les autres sont requises.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
